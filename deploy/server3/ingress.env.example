# Nonsecret server3 topology inputs. Copy to /opt/kira/ingress.env, not into the repo.
# All values are intentionally empty: an unprovisioned deployment must fail closed.
# Choose a collision-free IPv4 subnet for the dedicated Backend/Admin NAT bridge.
KIRA_SERVER3_ADMIN_SUBNET=
# Provision its gateway and an available, distinct Admin address within that subnet.
KIRA_SERVER3_ADMIN_GATEWAY=
KIRA_SERVER3_ADMIN_ADDRESS=
# Exact Backend-observed peer of host Nginx's loopback connection, not an assumed
# gateway or an entire CIDR. Measure in the provisioned topology and recheck after
# network/container recreation. It must differ from KIRA_SERVER3_ADMIN_ADDRESS.
KIRA_SERVER3_HOST_PEER=
