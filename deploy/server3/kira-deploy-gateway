#!/usr/bin/env bash
set -euo pipefail

original=${SSH_ORIGINAL_COMMAND:-}
if [[ $original =~ ^deploy\ backend\ ([0-9a-f]{40})\ ([0-9a-f]{64})\ (sha256:[0-9a-f]{64})$ ]]; then
  exec sudo /usr/local/sbin/kira-deploy deploy backend "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
fi
if [[ $original =~ ^deploy\ (web|admin)\ ([0-9a-f]{40})$ ]]; then
  exec sudo /usr/local/sbin/kira-deploy deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi

printf 'Only Kira image deployment is permitted.\n' >&2
exit 64
