+        assertEquals(Oid.INT4_ARRAY,
+            f.call(types, TypeInfo.class, "getPGType", new Class<?>[]{String.class}, "\"int4\"[]"));
+        break;
+      case "getNameStatement":
+        f.call(types, TypeInfo.class, "getPGType", new Class<?>[]{int.class}, 99999999);
+        break;
+      case "getArrayElementOidStatement":
+      case "getArrayDelimiterStatement":
+        // aclitem is a real builtin but is not in TypeInfoCache's eagerly installed core types.
+        int arrayOid = f.scalar("select 'pg_catalog.aclitem[]'::regtype::oid::int");
