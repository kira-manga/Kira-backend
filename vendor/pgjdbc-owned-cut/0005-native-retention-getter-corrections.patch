+      SQLException marker = new SQLException("test after metadata query actually produced its hidden result");
+      AtomicInteger injected = new AtomicInteger();
+      QueryExecutor original = f.connection.getQueryExecutor();
+      try (ExecutorFault ignored = new ExecutorFault(f.connection, invocation -> {
+        boolean metadataQuery = invocation.getMethod().getName().equals("execute")
+            && invocation.getArgument(0) instanceof Query
+            && ((Query) invocation.getArgument(0)).getNativeSql().contains("FROM pg_catalog.pg_proc p,");
+        Object returned = delegate(original, invocation);
+        if (metadataQuery) {
+          injected.incrementAndGet();
+          throw marker;
+        }
+        return returned;
+      })) {
+        assertSame(marker, assertThrows(SQLException.class, () -> f.call(metadata, DatabaseMetaData.class,
+            "getProcedureColumns", new Class<?>[]{String.class, String.class, String.class, String.class},
+            null, "pg_catalog", "abs", null)));
+      }
+      assertEquals(1, injected.get());
+      List<KiraOwnedJdbcCut.Native> leftovers = new ArrayList<>();
+      boolean nonCacheStatement = false;
+      boolean resultWithTuples = false;
+      TypeInfoCache types = (TypeInfoCache) f.connection.getTypeInfo();
+      for (KiraOwnedJdbcCut.Native child = f.connection.kira.children; child != null; child = child.next) {
+        if (KiraOwnedJdbcCut.firstCloseState(child.life) != 0) {
+          continue;
+        }
+        leftovers.add(child);
+        if (child.receiver instanceof PgPreparedStatement) {
+          nonCacheStatement |= !types.kiraOwnsStatement(f.connection, (PgPreparedStatement) child.receiver);
+        } else if (child.receiver instanceof PgResultSet) {
+          resultWithTuples |= !((PgResultSet) child.receiver).rows.isEmpty();
+        }
+      }
+      assertTrue(nonCacheStatement);
+      assertTrue(resultWithTuples);
+      assertEquals(0, KiraOwnedJdbcCut.rootState(f.root));
+      assertEquals(4, KiraOwnedJdbcCut.retentionState(f.root));
+      assertEquals((long) leftovers.size(), KiraOwnedJdbcCut.liveNativeChildren(f.root));
+      for (KiraOwnedJdbcCut.Native child : leftovers) {
+        assertTrue(child.factoryReturned);
+        assertNotNull(child.receiver);
+        assertEquals(0, KiraOwnedJdbcCut.firstCloseState(child.life));
+      }
+      f.retire();
+      for (KiraOwnedJdbcCut.Native child : leftovers) {
+        assertEquals(2, KiraOwnedJdbcCut.firstCloseState(child.life));
+      }
+    }
+  }
