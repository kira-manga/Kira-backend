+            slot.equals("getArrayElementOidStatement") ? "getPGArrayElement" : "getArrayDelimiter",
+            new Class<?>[]{int.class}, arrayOid);
+        break;
+      case "getTypeInfoStatement":
+        f.call(types, TypeInfo.class, "getSQLType", new Class<?>[]{int.class}, 99999999);
+        break;
+      case "getAllTypeInfoStatement":
+        f.call(types, TypeInfoCache.class, "cacheSQLTypes", NONE);
+        break;
+      default:
+        throw new IllegalArgumentException("Unknown TypeInfo test field.");
+    }
+    PgPreparedStatement statement = (PgPreparedStatement) field(types, slot);
+    assertNotNull(statement);
+    assertTrue(types.kiraOwnsStatement(f.connection, statement));
