+  /** Bridge-only: a candidate is used only for this exact receiver and stored source identity. */
+  public static Binding binding(EngineKey key, Object receiver, ParameterList list, int position,
+      Object stored, Object retainedSource) {
+    requireEngine(key);
+    Native n = nativeState(receiver);
+    if (n == null) {
+      return new Binding(stored, null, NO_LIVES, true);
+    }
+    Object source = retainedSource == null ? stored : retainedSource;
+    Invocation invocation = current(n.connection);
+    Transfer transfer = n.connection.transfer;
+    if (transfer != null && transfer.thread == Thread.currentThread()
+        && transfer.cause == invocation
+        && transfer.destination == receiver && transfer.parameters == list
+        && transfer.position == position && transfer.value == source) {
+      Binding row = transfer.row == null ? null : transfer.row.binding;
+      return row == null ? new Binding(stored, null, NO_LIVES, false)
+          : new Binding(stored, row.owner, row.dependencies, row.complete);
+    }
+    if (invocation == null) {
+      if (!custodyOnlyPhase(n.connection)) {
+        markUnknown(n);
+      }
+      return new Binding(stored, null, NO_LIVES, true);
+    }
+    int count = 0;
+    for (int i = 0; i < invocation.knownValues.length; i++) {
+      if (source != null && invocation.knownValues[i] == source) {
+        count++;
+      }
+    }
+    if (count == 0) {
+      return new Binding(stored, null, NO_LIVES, true);
+    }
+    Life[] lives = new Life[count];
+    int at = 0;
+    for (int i = 0; i < invocation.knownValues.length; i++) {
+      if (invocation.knownValues[i] == source) {
+        lives[at++] = invocation.knownLives[i];
+      }
+    }
+    boolean exact = invocation.receiver == receiver;
+    if (!exact) {
+      uncertain(invocation);
+    }
+    return new Binding(stored, invocation.owner, lives, exact);
+  }
