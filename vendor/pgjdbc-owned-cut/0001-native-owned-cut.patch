+  private static Native nativeStarted(NativeConnection c, Object receiver, int kind, Life parent) {
+    Construction record = c.construction;
+    if (record != null && record.thread == Thread.currentThread() && !record.ended) {
+      record.receiver = receiver; // Retain this before allocating any child bookkeeping.
+    } else {
+      record = null;
+    }
+    Native n = new Native(c, receiver, kind, parent);
+    if (record != null) {
+      record.nativeState = n;
+    } else {
+      c.nativeChildren = Math.addExact(c.nativeChildren, 1L);
+      n.available = true; // Unreserved native/test construction has no facade publication receipt.
+    }
+    n.next = c.children;
+    c.children = n;
+    return n;
+  }
