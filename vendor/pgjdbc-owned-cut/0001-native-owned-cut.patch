+  private static void cleanupConstructions(NativeConnection c) {
+    for (Construction record = c.constructions; record != null; record = record.next) {
+      if (!record.ended || record.returned || record.cleaned) {
+        continue;
+      }
+      boolean completed = false;
+      try {
+        if (record.receiverComplete && record.receiver instanceof PgStatement) {
+          ((PgStatement) record.receiver).close();
+        } else if (record.receiverComplete && record.receiver instanceof PgResultSet) {
+          ((PgResultSet) record.receiver).close();
+        } else {
+          for (Borrow borrow = record.borrows; borrow != null; borrow = borrow.next) {
+            if (borrow.query != null) {
+              borrow.query.query.close();
+              borrow.query = null;
+            }
+          }
+          if (record.cursor != null) {
+            record.cursor.close();
+            record.cursor = null;
+          }
+        }
+        if (record.receiverComplete && record.nativeState != null) {
+          // A repeated/no-op close cannot upgrade an earlier failed first close.
+          completed = record.nativeState.life.first == 2;
+        } else {
+          completed = true;
+        }
+      } catch (Throwable failure) {
+        if (failure instanceof InterruptedException) {
+          Thread.currentThread().interrupt();
+        }
+        record.cleanupFailed = true;
+        cleanupFailure(c, null);
+      } finally {
+        if (completed) {
+          record.cleaned = true;
+          c.failedConstructions--;
+          record.receiver = null;
+          record.borrows = null;
+          record.cursor = null;
+          if (record.nativeState != null && !record.receiverComplete) {
+            record.nativeState.partialDisposed = true;
+          }
+        }
+      }
+    }
+  }
+
+  private static void compact(NativeConnection c) {
+    Construction previous = null;
+    Construction record = c.constructions;
+    while (record != null) {
+      Construction next = record.next;
+      if (record.ended && (record.returned || record.cleaned)) {
+        if (previous == null) {
+          c.constructions = next;
+        } else {
+          previous.next = next;
+        }
+        record.next = null;
+        record.receiver = null;
+        record.nativeState = null;
+      } else {
+        previous = record;
+      }
+      record = next;
+    }
+    Native before = null;
+    Native n = c.children;
+    while (n != null) {
+      Native next = n.next;
+      if (n.life.first == 2 || n.partialDisposed) {
+        if (before == null) {
+          c.children = next;
+        } else {
+          before.next = next;
+        }
+        n.next = null;
+        n.receiver = null;
+        n.life.firstCause = null;
+        // Retire future-use authority of an irreversibly closed receiver, not its actual
+        // Java fields or the separate arrays/pins owned by any still-active Invocation.
+        n.queries = null;
+        n.queryTail = null;
+        n.parameters = null;
+        n.parameterTail = null;
+        n.queryList = null;
+        n.parameterList = null;
+        n.rowMap = null;
+        n.rows = null;
+      } else {
+        before = n;
+      }
+      n = next;
+    }
+    c.drainWeakLives();
+  }
