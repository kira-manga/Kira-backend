+      mutation.nativeState.rows = mutation.rows;
+      mutation.nativeState.rowMap = mutation.map;
+      mutation.stored = true;
+    }
+  }
+
+  static void rowEnded(@Nullable RowMutation mutation) {
+    if (mutation != null && !mutation.stored) {
+      markUnknown(mutation.nativeState);
+    }
+  }
+
+  static @Nullable Row rowUse(@Nullable Native n, Map<String, Object> map, String key, Object value)
+      throws SQLException {
+    if (n == null) {
+      return null;
+    }
+    Row row = n.rows.get(key);
+    if (n.rowMap != map || row == null || row.value != value) {
+      markUnknown(n);
+      pin(n, map, value);
+      return null;
+    }
+    pin(n, row, value);
+    if (!bindingLive(row.binding, current(n.connection))) {
+      throw refused();
+    }
+    return row;
+  }
+
+  static final class Transfer {
+    final NativeConnection connection;
+    final Thread thread = Thread.currentThread();
+    final Invocation cause;
+    final Object destination;
+    final ParameterList parameters;
+    final int position;
+    final Object value;
+    final Row row;
+    final Transfer parent;
+
+    Transfer(NativeConnection c, Object destination, ParameterList parameters, int position,
+        Object value, Row row) {
+      this.connection = c;
+      this.cause = current(c);
+      this.destination = destination;
+      this.parameters = parameters;
+      this.position = position;
+      this.value = value;
+      this.row = row;
+      this.parent = c.transfer;
+    }
+  }
+
+  static @Nullable Transfer transfer(@Nullable Native source, Map<String, Object> map, String key, Object value,
+      Object destination, int position) throws SQLException {
+    if (source == null || !(destination instanceof PgPreparedStatement)) {
+      if (source != null) {
+        markUnknown(source);
+      }
+      return null;
+    }
+    PgPreparedStatement target = (PgPreparedStatement) destination;
+    Row row = rowUse(source, map, key, value);
+    if (target.kira.connection != source.connection) {
+      markUnknown(source);
+      return null;
+    }
+    Transfer transfer = new Transfer(source.connection, destination, target.preparedParameters,
+        position, value, row);
+    source.connection.transfer = transfer;
+    return transfer;
+  }
+
+  static void transferEnded(@Nullable Transfer transfer) {
+    if (transfer == null) {
+      return;
+    }
+    NativeConnection c = transfer.connection;
+    if (transfer.thread != Thread.currentThread() || c.transfer != transfer) {
+      c.uncertain = true;
+      Invocation invocation = current(c);
+      if (invocation != null) {
+        uncertain(invocation);
+      }
+    } else {
+      c.transfer = transfer.parent;
+    }
+  }
+}
