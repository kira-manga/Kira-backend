+ * Portions of this work integrate with pgjdbc, distributed under the BSD-2-Clause license.
+ */
+package org.postgresql.core.v3;
+
+import org.postgresql.core.ParameterList;
+import org.postgresql.jdbc.KiraOwnedJdbcCut;
+import org.postgresql.jdbc.KiraOwnedJdbcCut.Binding;
+import org.postgresql.jdbc.KiraOwnedJdbcCut.EngineKey;
+import org.postgresql.jdbc.KiraOwnedJdbcCut.Image;
+import org.postgresql.jdbc.KiraOwnedJdbcCut.Pin;
+
+import org.checkerframework.checker.initialization.qual.UnknownInitialization;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/** Closed concrete-list metadata bridge; not a ParameterList API or a raw-value getter. */
+@SuppressWarnings({"nullness", "initialization"})
+public final class KiraOwnedParameterBridge {
+  private KiraOwnedParameterBridge() { }
+
+  private static volatile EngineKey engine;
+
+  public static void install(EngineKey key) {
+    KiraOwnedJdbcCut.requireEngine(key);
+    engine = key;
+  }
+
+  private static void require(EngineKey key) {
+    if (key == null || key != engine) {
+      throw new IllegalArgumentException("Not the owned parameter engine.");
+    }
+  }
+
+  // These references are the actual arrays supplied at native construction, not getter results.
+  static final class State {
+    final Object[] values;
+    Binding[] bindings;
+    Object owner;
+    ParameterList root;
+    int offset;
+    int changing;
+    boolean unknown;
+
+    State(@UnknownInitialization SimpleParameterList list, @Nullable Object[] values) {
+      this.values = values;
+      this.bindings = new Binding[values.length];
+      this.root = list;
+    }
+  }
+
+  static final class Composite {
+    final SimpleParameterList[] children;
+    final int[] offsets;
+
+    Composite(SimpleParameterList[] children, int[] offsets) {
+      this.children = children;
+      this.offsets = offsets;
+    }
+  }
+
+  public static void attach(EngineKey key, ParameterList list, Object receiver) {
+    require(key);
+    if (list.getClass() == SimpleParameterList.class) {
+      attachState(key, ((SimpleParameterList) list).kira, receiver, list, 0);
+    } else if (list.getClass() == CompositeParameterList.class) {
+      Composite state = ((CompositeParameterList) list).kira;
+      for (int i = 0; i < state.children.length; i++) {
+        SimpleParameterList child = state.children[i];
+        if (child.getClass() != SimpleParameterList.class) {
+          KiraOwnedJdbcCut.incomplete(key, receiver, null);
+        } else {
+          attachState(key, child.kira, receiver, list, state.offsets[i]);
+        }
+      }
+    } else {
+      KiraOwnedJdbcCut.incomplete(key, receiver, null);
+    }
+  }
+
+  private static void attachState(EngineKey key, State state, Object receiver,
+      ParameterList root, int offset) {
+    if (state.values.length == 0) {
+      // SimpleQuery.NO_PARAMETERS is a shared, permanently ownerless empty value.
+      return;
+    }
+    if (state.owner != null && state.owner != receiver) {
+      state.unknown = true;
+      KiraOwnedJdbcCut.incomplete(key, receiver, null);
+      return;
+    }
+    state.owner = receiver;
+    state.root = root;
+    state.offset = offset;
+  }
+
+  public static Image snapshot(EngineKey key, ParameterList list, Object receiver) {
+    require(key);
+    if (list.getClass() == SimpleParameterList.class) {
+      return snapshotState(key, ((SimpleParameterList) list).kira, receiver);
+    }
+    if (list.getClass() == CompositeParameterList.class) {
+      Composite state = ((CompositeParameterList) list).kira;
+      Image[] images = new Image[state.children.length];
+      for (int i = 0; i < images.length; i++) {
+        SimpleParameterList child = state.children[i];
+        images[i] = child.getClass() == SimpleParameterList.class
+            ? snapshotState(key, child.kira, receiver) : KiraOwnedJdbcCut.unknownImage(key);
+      }
+      return KiraOwnedJdbcCut.mergeImages(key, images);
+    }
+    return KiraOwnedJdbcCut.unknownImage(key);
+  }
+
+  private static Image snapshotState(EngineKey key, State state, Object receiver) {
+    if (state.values.length == 0) {
+      return KiraOwnedJdbcCut.image(key, state.bindings, state.values, true);
+    }
+    boolean owned = state.values.length == 0 || state.owner == receiver;
+    return KiraOwnedJdbcCut.image(key, state.bindings, state.values,
+        owned && state.changing == 0 && !state.unknown);
+  }
+
+  static final class Slot {
+    final EngineKey key;
+    final State state;
+    final int index;
+    final Binding binding;
+    final Pin pin;
+    boolean stored;
+
+    Slot(State state, int index, Object value, Object source) {
+      this.key = engine;
+      this.state = state;
+      this.index = index;
+      this.binding = key == null ? null : KiraOwnedJdbcCut.binding(key, state.owner, state.root,
+          state.offset + index + 1, value, source);
+      this.pin = key == null ? null
+          : KiraOwnedJdbcCut.retain(key, state.owner, state.bindings[index], binding);
+    }
+  }
+
+  static Slot bind(SimpleParameterList list, int index, Object value, @Nullable Object source) {
+    Slot slot = new Slot(list.kira, index, value, source);
+    list.kira.changing++;
+    return slot;
+  }
+
+  static void stored(Slot slot) {
+    slot.state.bindings[slot.index] = slot.binding;
+    slot.stored = true;
+    slot.state.changing--;
+    // The exact Invocation keeps its old/new pins through core output guarding and actualEnd.
+  }
+
+  static void ended(Slot slot) {
+    if (!slot.stored) {
+      slot.state.unknown = true;
+      slot.state.changing--;
+      if (slot.key != null) {
+        KiraOwnedJdbcCut.incomplete(slot.key, slot.state.owner, slot.pin);
+      }
+    }
+  }
+
+  static final class Bulk {
+    final EngineKey key;
+    final State state;
+    final Binding[] after;
+    final Pin pin;
+    boolean valuesStored;
+    final boolean empty;
+
+    Bulk(State state, Binding[] after, Object nativeCopy) {
+      this.key = engine;
+      this.state = state;
+      this.empty = state.values.length == 0;
+      this.after = after;
+      this.pin = key == null ? null
+          : KiraOwnedJdbcCut.retain(key, state.owner, nativeCopy, state.bindings);
+    }
+  }
+
+  static Bulk copy(SimpleParameterList source, SimpleParameterList destination) {
+    State from = source.kira;
+    State to = destination.kira;
+    if (to.values.length != 0) {
+      to.owner = from.owner;
+    }
+    if (to.values.length != 0) {
+      to.unknown |= from.unknown || from.changing != 0
+          || source.getClass() != SimpleParameterList.class
+          || destination.getClass() != SimpleParameterList.class;
+    }
+    Bulk bulk = new Bulk(to, from.bindings.clone(), destination);
+    if (!bulk.empty) {
+      to.changing++;
+    }
+    return bulk;
+  }
+
+  static Bulk append(SimpleParameterList source, SimpleParameterList destination,
+      int position, int count) {
+    State from = source.kira;
+    State to = destination.kira;
+    Binding[] after = to.bindings.clone();
+    System.arraycopy(from.bindings, 0, after, position, count);
+    if (to.values.length != 0) {
+      to.unknown |= from.unknown || from.changing != 0
+          || source.getClass() != SimpleParameterList.class
+          || destination.getClass() != SimpleParameterList.class
+          || (from.owner != null && from.owner != to.owner);
+    }
+    Bulk bulk = new Bulk(to, after, destination);
+    if (!bulk.empty) {
+      to.changing++;
+    }
+    return bulk;
+  }
+
+  static Bulk clear(SimpleParameterList list) {
+    State state = list.kira;
+    Bulk bulk = new Bulk(state, new Binding[state.bindings.length], list);
+    if (!bulk.empty) {
+      state.changing++;
+    }
+    return bulk;
+  }
+
+  static void valuesStored(Bulk bulk) {
+    if (!bulk.empty) {
+      bulk.state.bindings = bulk.after;
+    }
+    bulk.valuesStored = true;
+  }
+
+  static void ended(Bulk bulk, boolean returned) {
+    if (bulk.empty) {
+      return;
+    }
+    bulk.state.changing--;
+    if (!returned || !bulk.valuesStored) {
+      bulk.state.unknown = true;
+      if (bulk.key != null) {
+        KiraOwnedJdbcCut.incomplete(bulk.key, bulk.state.owner, bulk.pin);
+      }
+    }
+  }
+
+  static void copied(CompositeParameterList source, CompositeParameterList destination) {
+    EngineKey key = engine;
+    if (key == null) {
+      return;
+    }
+    Object receiver = null;
+    for (SimpleParameterList child : source.kira.children) {
+      if (child.kira.owner != null) {
+        receiver = child.kira.owner;
+        break;
+      }
+    }
+    if (receiver != null) {
+      attach(key, destination, receiver);
+      KiraOwnedJdbcCut.retain(key, receiver, destination, null);
+    }
+  }
+}
