+  private static boolean sameImage(Image expected, Image actual) {
+    if (!expected.complete || !actual.complete
+        || expected.bindings.length != actual.bindings.length) {
+      return false;
+    }
+    for (int i = 0; i < expected.bindings.length; i++) {
+      if (expected.bindings[i] != actual.bindings[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
