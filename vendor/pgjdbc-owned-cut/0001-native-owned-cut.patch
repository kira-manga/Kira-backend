+  /** Preparation and the last closed walk. The source caller then performs direct stores/clears. */
+  static void prepareDrain(Batch batch, ArrayList<Query> queries,
+      ArrayList<? extends @Nullable ParameterList> parameters) throws SQLException {
+    Native n = batch.nativeState;
+    batch.queryImage = n.queries;
+    batch.parameterImage = n.parameters;
+    Image[] images = new Image[batch.parameters.length];
+    batch.actualImages = images;
+    for (int i = 0; i < images.length; i++) {
+      ParameterList list = batch.parameters[i];
+      images[i] = list == null ? EMPTY_IMAGE
+          : KiraOwnedParameterBridge.snapshot(ENGINE, list, n.receiver);
+    }
