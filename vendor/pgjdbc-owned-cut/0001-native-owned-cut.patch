+  public static Image image(EngineKey key, Binding[] bindings, Object[] actualValues,
+      boolean complete) {
+    requireEngine(key);
+    Binding[] copied = bindings.clone();
+    complete &= copied.length == actualValues.length;
+    for (int i = 0; i < copied.length && i < actualValues.length; i++) {
+      Binding binding = copied[i];
+      complete &= binding == null ? actualValues[i] == null
+          : binding.complete && binding.stored == actualValues[i];
+    }
+    return copied.length == 0 && complete ? EMPTY_IMAGE : new Image(copied, complete);
+  }
+
+  public static Image mergeImages(EngineKey key, Image[] images) {
+    requireEngine(key);
+    int count = 0;
+    boolean complete = true;
+    for (Image image : images) {
+      count = Math.addExact(count, image.bindings.length);
+      complete &= image.complete;
+    }
+    Binding[] bindings = new Binding[count];
+    int at = 0;
+    for (Image image : images) {
+      System.arraycopy(image.bindings, 0, bindings, at, image.bindings.length);
+      at += image.bindings.length;
+    }
+    return count == 0 && complete ? EMPTY_IMAGE : new Image(bindings, complete);
+  }
