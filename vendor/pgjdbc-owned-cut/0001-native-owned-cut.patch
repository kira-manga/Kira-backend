+    final Invocation cause;
+    Batch parent;
+    int depth = 1;
+    volatile int phase = 1;
+    volatile boolean ended;
+    Query[] queries;
+    @Nullable ParameterList[] parameters;
+    Node queryImage;
+    Node parameterImage;
+    Image[] actualImages;
