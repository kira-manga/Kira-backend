+    if (existing != null && existing.cause == cause && !existing.ended) {
+      // PgPreparedStatement.executeBatch -> the native base implementation, not reentry.
+      existing.depth++;
+      return existing;
+    }
+    Batch batch = new Batch(n, cause);
+    batch.parent = existing;
+    n.activeBatch = batch;
+    if (cause != null) {
+      if (cause.receiver != n.receiver || !isBatch(cause.operation) || cause.batch != null) {
+        uncertain(cause);
+        pin(n, batch, null);
