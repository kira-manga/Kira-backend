+    // From here to the two native clears: no callbacks, new allocations, class
+    // initialization, engine calls, locks or producer/admission checks on success.
+    boolean exact = queries.getClass() == ArrayList.class && parameters.getClass() == ArrayList.class
+        && n.receiver instanceof PgStatement
+        && ((PgStatement) n.receiver).batchStatements == queries
+        && ((PgStatement) n.receiver).batchParameters == parameters
+        && n.queryList == queries && n.parameterList == parameters
+        && batch.queries.length == queries.size() && batch.parameters.length == parameters.size()
+        && (batch.cause == null || (current(n.connection) == batch.cause
+            && batch.cause.receiver == n.receiver && !batch.cause.ended));
+    Node query = batch.queryImage;
+    for (int i = 0; i < batch.queries.length; i++) {
+      exact &= query != null && query.value == batch.queries[i];
+      if (queries.getClass() == ArrayList.class) {
+        exact &= i < queries.size() && queries.get(i) == batch.queries[i];
+      }
+      query = query == null ? null : query.next;
+    }
+    exact &= query == null;
+    Node parameter = batch.parameterImage;
+    boolean lives = true;
+    for (int i = 0; i < batch.parameters.length; i++) {
+      Image actual = images[i];
+      exact &= parameter != null && parameter.value == batch.parameters[i] && actual.complete;
+      if (parameters.getClass() == ArrayList.class) {
+        exact &= i < parameters.size() && parameters.get(i) == batch.parameters[i];
+      }
+      if (parameter != null) {
+        exact &= sameImage(parameter.image, actual);
+      }
+      for (Binding binding : actual.bindings) {
+        lives &= bindingLive(binding, batch.cause);
+      }
+      parameter = parameter == null ? null : parameter.next;
+    }
+    exact &= parameter == null;
+    if (!exact) {
+      markUnknown(n);
+    }
+    if (!lives) {
+      throw refused();
+    }
+  }
