+/** Closed private-artifact ABI: no raw getter or generic JDBC invocation service. */
+@SuppressWarnings({"nullness", "initialization"})
+public final class KiraOwnedJdbcCut {
+  private KiraOwnedJdbcCut() { }
+
+  private static final ThreadLocal<Opening> OPENING = new ThreadLocal<>();
+  private static final EngineKey ENGINE = new EngineKey();
+  private static final Binding[] NO_BINDINGS = new Binding[0];
+  private static final Life[] NO_LIVES = new Life[0];
+  private static final Image EMPTY_IMAGE = new Image(NO_BINDINGS, true);
+  private static final Image UNKNOWN_IMAGE = new Image(NO_BINDINGS, false);
+  private static final AtomicIntegerFieldUpdater<Life> FIRST =
+      AtomicIntegerFieldUpdater.newUpdater(Life.class, "first");
+  private static final AtomicReferenceFieldUpdater<NativeConnection, Invocation> RETAINED =
+      AtomicReferenceFieldUpdater.newUpdater(NativeConnection.class, Invocation.class, "retained");
+
+  public static void prepareRuntime() {
+    KiraOwnedParameterBridge.install(ENGINE);
+    // Resolve the updater and closed empty representations before any native acquisition.
+    FIRST.get(new Life(null, null, 0, null));
+  }
+
+  public static final class EngineKey {
+    private EngineKey() { }
+  }
+
+  public static final class Opening {
+    private final Driver driver;
+    private final Object entry;
+    private final Thread thread = Thread.currentThread();
+    private Opening parent;
+    private NativeConnection connections;
+    private Connection returned;
+    private boolean armed;
+    private volatile boolean ended;
+    private volatile boolean cleanupEnded;
+    private volatile boolean cleanupFailed;
+    private volatile boolean correspondenceFailed;
+    private final AtomicBoolean cleanupClaim = new AtomicBoolean();
+
+    private Opening(Driver driver, Object entry) {
+      this.driver = driver;
+      this.entry = entry;
+    }
+  }
+
+  public static Opening prepareOpening(Driver driver, Object entryKey) throws SQLException {
+    if (driver == null || entryKey == null || driver.getClass() != org.postgresql.Driver.class) {
+      throw refused();
+    }
+    prepareRuntime();
+    return new Opening(driver, entryKey);
+  }
+
+  public static void armOpening(Opening opening) throws SQLException {
+    if (opening.thread != Thread.currentThread() || opening.armed || opening.ended) {
+      throw refused();
+    }
+    opening.parent = OPENING.get();
+    OPENING.set(opening);
+    opening.armed = true;
+  }
+
+  public static void recordReturned(Opening opening, @Nullable Connection returned) throws SQLException {
+    requireOpening(opening);
+    if (opening.returned != null && opening.returned != returned) {
+      opening.correspondenceFailed = true;
+      throw refused();
+    }
+    // The exact raw exclusion is custody, not a constructor/admission receipt. Publish
+    // it before any later correspondence refusal; Entry.raw was already retained by core.
+    opening.correspondenceFailed = true;
+    opening.returned = returned;
+    if (returned != null) {
+      NativeConnection found = findConnection(opening, returned);
+      if (found == null || !found.constructorEnded || !found.constructorReturned) {
+        throw refused();
+      }
+    }
+    opening.correspondenceFailed = false;
+  }
+
+  public static void endOpening(Opening opening) throws SQLException {
+    requireOpening(opening);
+    OPENING.set(opening.parent);
+    opening.parent = null;
+    opening.ended = true;
+  }
+
+  private static void requireOpening(Opening opening) throws SQLException {
+    if (opening.thread != Thread.currentThread() || !opening.armed || opening.ended
+        || OPENING.get() != opening) {
+      throw refused();
+    }
+  }
+
+  public static int openingState(Opening opening) {
+    int flags = opening.ended ? 1 : 0;
+    if (opening.correspondenceFailed) {
+      flags |= 2;
+    }
+    if (opening.cleanupFailed) {
+      flags |= 4;
+    }
+    if (opening.cleanupEnded) {
+      flags |= 8;
+    }
+    for (NativeConnection c = opening.connections; c != null; c = c.next) {
+      if (c.constructorEnded && !c.constructorReturned) {
+        flags |= 16;
+      }
+      if (!c.constructorEnded || (c.connection != opening.returned && !c.cleaned)
+          || c.failedConstructions != 0 || c.uncertain
+          || (opening.cleanupEnded && c.nativeChildren != 0)) {
+        flags |= 2;
+      }
+      if (c.cleanupFailed) {
+        flags |= 4;
+      }
+    }
+    return flags;
+  }
+
+  /** Terminal-only physical cleanup. Never calls close() on a partially constructed connection. */
+  public static void cleanupOpening(Opening opening) {
+    if (!opening.ended || !opening.cleanupClaim.compareAndSet(false, true)) {
+      return;
+    }
+    try {
+      for (NativeConnection c = opening.connections; c != null; c = c.next) {
+        if (!c.constructorEnded) {
+          c.uncertain = true;
+          continue;
+        }
+        c.terminalCleanup = true;
+        try {
+          cleanupConstructions(c);
+          compact(c);
+        } finally {
+          c.terminalCleanup = false;
+        }
+        if (c.connection == opening.returned || c.cleaned) {
+          continue;
+        }
+        boolean completed = false;
+        try {
+          if (c.cleanable != null) {
+            c.cleanable.clean();
+          } else if (c.action != null) {
+            c.action.onClean(false);
+          } else if (c.executor != null) {
+            c.executor.getCloseAction().close();
+          }
+          completed = true;
+        } catch (Throwable failure) {
+          if (failure instanceof InterruptedException) {
+            Thread.currentThread().interrupt();
+          }
+          c.cleanupFailed = true;
+          opening.cleanupFailed = true;
+        } finally {
+          c.cleaned = completed;
+        }
+      }
+    } finally {
+      opening.cleanupEnded = true;
+    }
+  }
+
+  public static final class Root {
+    private final NativeConnection nativeConnection;
+    private final Object context;
+    private final Object epoch;
+
+    private Root(NativeConnection nativeConnection, Object context, Object epoch) {
+      this.nativeConnection = nativeConnection;
+      this.context = context;
+      this.epoch = epoch;
+    }
+  }
+
+  private static final class RootRef extends WeakReference<Root> {
+    RootRef next;
+
+    RootRef(Root root, RootRef next) {
+      super(root);
+      this.next = next;
+    }
+  }
+
+  public static Root attach(Opening opening, Connection connection, Object contextKey,
+      Object epochKey) throws SQLException {
+    NativeConnection c = findConnection(opening, connection);
+    if (!opening.ended || opening.correspondenceFailed || opening.returned != connection || c == null
+        || !c.constructorReturned || !c.constructorEnded || contextKey == null || epochKey == null) {
+      throw refused();
+    }
+    RootRef previous = null;
+    RootRef next = c.roots;
+    while (next != null) {
+      Root candidate = next.get();
+      if (candidate == null) {
+        if (previous == null) {
+          c.roots = next.next;
+        } else {
+          previous.next = next.next;
+        }
+      } else {
+        if (candidate.context == contextKey && candidate.epoch == epochKey) {
+          return candidate;
+        }
+        previous = next;
+      }
+      next = next.next;
+    }
+    Root r = new Root(c, contextKey, epochKey);
+    c.roots = new RootRef(r, c.roots);
+    return r;
+  }
+
+  private static NativeConnection findConnection(Opening opening, Connection connection) {
+    for (NativeConnection c = opening.connections; c != null; c = c.next) {
+      if (c.connection == connection) {
+        return c;
+      }
+    }
+    return null;
+  }
+
+  public static final class Owner {
+    private final Root root;
+    private final Thread original = Thread.currentThread();
+
+    private Owner(Root root) {
+      this.root = root;
+    }
+  }
+
+  public static Owner owner(Root root) {
+    return new Owner(root);
+  }
+
+  public static final class Life {
+    private final NativeConnection connection;
+    private final Life parent;
+    private final int kind;
+    private final Native nativeState;
+    private volatile boolean revoked;
+    // Package access is required by Java8's AtomicIntegerFieldUpdater access rules.
+    volatile int first;
+    private Thread firstThread;
+    private Invocation firstCause;
+    private int firstScope;
+
+    private Life(NativeConnection connection, Life parent, int kind, Native nativeState) {
+      this.connection = connection;
+      this.parent = parent;
+      this.kind = kind;
+      this.nativeState = nativeState;
+    }
+  }
+
+  public static Life life(Owner owner, Object nativeIdentity, @Nullable Life lifetimeParent,
+      boolean disposable) throws SQLException {
+    requireOwner(owner);
+    NativeConnection c = owner.root.nativeConnection;
+    if (nativeIdentity == null || (lifetimeParent != null && lifetimeParent.connection != c)) {
+      throw refused();
+    }
+    Native n = nativeState(nativeIdentity);
+    if (n != null) {
+      if (n.connection != c) {
+        throw refused();
+      }
+      return n.life;
+    }
+    c.drainWeakLives();
+    WeakKey key = new WeakKey(nativeIdentity, null);
+    Life old = c.otherLives.get(key);
+    if (old != null) {
+      return old;
+    }
+    Life created = new Life(c, lifetimeParent, disposable ? 3 : 0, null);
+    c.otherLives.put(new WeakKey(nativeIdentity, c.deadLives), created);
+    return created;
+  }
+
+  public static boolean isLive(Owner owner, Life life) {
+    return owner.original == Thread.currentThread() && liveFor(owner, life);
+  }
+
+  private static boolean liveFor(Owner owner, Life life) {
+    if (life == null || life.connection != owner.root.nativeConnection) {
+      return false;
+    }
+    for (Life next = life; next != null; next = next.parent) {
+      if (next.revoked || (next.nativeState != null && !next.nativeState.available)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  public static boolean revoke(Owner owner, Life life) throws SQLException {
+    requireOwner(owner);
+    if (life.connection != owner.root.nativeConnection) {
+      throw refused();
+    }
+    boolean first = !life.revoked;
+    life.revoked = true;
+    return first;
+  }
+
+  public static int lifeKind(Life life) {
+    return life.kind;
+  }
+
+  public static int firstCloseState(Life life) {
+    return life.first;
+  }
+
+  public static long liveNativeChildren(Root root) {
+    return root.nativeConnection.nativeChildren;
+  }
+
+  public static int rootState(Root root) {
+    NativeConnection c = root.nativeConnection;
+    return (c.cleanupFailed ? 1 : 0) | (c.uncertain || c.failedConstructions != 0 ? 2 : 0);
+  }
+
+  public static final class Invocation {
+    private final Owner owner;
+    private Object receiver;
+    private Object callKey;
+    private final String operation;
+    private Object[] arguments;
+    private Object[] knownValues;
+    private Life[] knownLives;
+    private int[] positions;
+    private final Thread actual = Thread.currentThread();
+    private final boolean cancellation;
+    private Invocation parent;
+    private Invocation retainedNext;
+    private Pin pins;
+    private Batch batch;
+    private boolean armed;
+    private boolean disarmed;
+    private boolean retained;
+    private volatile boolean ended;
+    private volatile boolean cleanupFailed;
+    private volatile boolean uncertain;
+
+    private Invocation(Owner owner, Object receiver, Object callKey, Method operation,
+        Object[] arguments, Object[] knownValues, Life[] knownLives, int[] positions) {
+      this.owner = owner;
+      this.receiver = receiver;
+      this.callKey = callKey;
+      this.operation = operation.getName();
+      this.arguments = arguments.clone();
+      this.knownValues = knownValues.clone();
+      this.knownLives = knownLives.clone();
+      this.positions = positions.clone();
+      this.cancellation = this.operation.equals("cancel") && receiver instanceof PgStatement;
+    }
+  }
+
+  public static Invocation prepareInvocation(Owner owner, Object nativeReceiver,
+      Object guardCallKey, Method operation, Object[] arguments, Object[] knownValues,
+      Life[] knownLives, int[] argumentPositions) throws SQLException {
+    if (owner == null || nativeReceiver == null || guardCallKey == null || operation == null
+        || arguments == null || knownValues == null || knownLives == null || argumentPositions == null
+        || !operation.getDeclaringClass().isInstance(nativeReceiver)
+        || operation.getParameterTypes().length != arguments.length
+        || knownValues.length != knownLives.length || knownValues.length != argumentPositions.length) {
+      throw refused();
+    }
+    boolean cancel = operation.getName().equals("cancel") && nativeReceiver instanceof PgStatement;
+    if (!cancel) {
+      requireOwner(owner);
+    }
+    NativeConnection c = owner.root.nativeConnection;
+    Native n = nativeState(nativeReceiver);
+    if (n != null && n.connection != c) {
+      throw refused();
+    }
+    if (nativeReceiver instanceof Connection && nativeReceiver != c.connection) {
+      throw refused();
+    }
+    for (int i = 0; i < knownLives.length; i++) {
+      if (knownLives[i] == null || knownLives[i].connection != c
+          || argumentPositions[i] < 0 || argumentPositions[i] >= arguments.length) {
+        throw refused();
+      }
+    }
+    return new Invocation(owner, nativeReceiver, guardCallKey, operation, arguments,
+        knownValues, knownLives, argumentPositions);
+  }
+
+  public static void arm(Invocation invocation) throws SQLException {
+    NativeConnection c = invocation.owner.root.nativeConnection;
+    if (invocation.actual != Thread.currentThread() || invocation.armed || invocation.ended) {
+      uncertain(invocation);
+      retainUncertain(invocation);
+      throw refused();
+    }
+    if (!invocation.cancellation) {
+      if (c.current != null && c.current.actual != Thread.currentThread()) {
+        uncertain(invocation);
+        retainUncertain(invocation);
+        throw refused();
+      }
+      invocation.parent = c.current;
+      c.current = invocation;
+    }
+    invocation.armed = true;
+  }
+
+  public static int invocationState(Invocation invocation) {
+    return (invocation.cleanupFailed ? 1 : 0) | (invocation.uncertain ? 2 : 0);
+  }
+
+  public static int drainState(Invocation invocation) {
+    Batch batch = invocation.batch;
+    if (batch == null) {
+      return isBatch(invocation.operation) ? 7 : 0;
+    }
+    if (invocation.uncertain) {
+      return 7;
+    }
+    if (batch.phase == 1 && batch.ended) {
+      return 6;
+    }
+    return batch.phase;
+  }
+
+  public static void disarm(Invocation invocation) throws SQLException {
+    NativeConnection c = invocation.owner.root.nativeConnection;
+    if (invocation.actual != Thread.currentThread() || !invocation.armed
+        || invocation.disarmed || invocation.ended
+        || (!invocation.cancellation && c.current != invocation)) {
+      uncertain(invocation);
+      retainUncertain(invocation);
+      throw refused();
+    }
+    if (!invocation.cancellation) {
+      c.current = invocation.parent;
+    }
+    invocation.parent = null;
+    invocation.disarmed = true;
+  }
+
+  public static void actualEnd(Invocation invocation) throws SQLException {
+    if (invocation.actual != Thread.currentThread() || invocation.ended) {
+      uncertain(invocation);
+      retainUncertain(invocation);
+      throw refused();
+    }
+    if (!invocation.disarmed) {
+      uncertain(invocation);
+      retainUncertain(invocation);
+      // A failed arm never installed this frame. Do not unwind an authentic other frame.
+      if (invocation.armed) {
+        throw refused();
+      }
+    }
+    if (isBatch(invocation.operation)
+        && (invocation.batch == null || !invocation.batch.ended
+            || (invocation.batch.phase > 1 && invocation.batch.phase < 5))) {
+      uncertain(invocation);
+    }
+    if (invocation.uncertain) {
+      retainUncertain(invocation);
+    } else {
+      invocation.pins = null;
+      if (invocation.batch != null) {
+        invocation.batch.releaseArrays();
+      }
+      invocation.arguments = null;
+      invocation.knownValues = null;
+      invocation.knownLives = null;
+      invocation.positions = null;
+      invocation.receiver = null;
+      invocation.callKey = null;
+    }
+    invocation.ended = true;
+    NativeConnection c = invocation.owner.root.nativeConnection;
+    // A foreign cancellation never mutates the original lineage's graph. Nor may an
+    // ended inner call retire data still needed by its admitted native ancestor.
+    if (!invocation.cancellation && c.current == null) {
+      compact(c);
+    }
+  }
+
+  private static boolean isBatch(String operation) {
+    return operation.equals("executeBatch") || operation.equals("executeLargeBatch");
+  }
+
+  private static void requireOwner(Owner owner) throws SQLException {
+    if (owner.original != Thread.currentThread()) {
+      throw refused();
+    }
+  }
+
+  private static SQLException refused() {
+    return new SQLException("Persistence JDBC operation refused.");
+  }
+
+  private static void uncertain(Invocation invocation) {
+    invocation.uncertain = true;
+    invocation.owner.root.nativeConnection.uncertain = true;
+  }
+
+  private static void retainUncertain(Invocation invocation) {
+    if (!invocation.retained) {
+      NativeConnection c = invocation.owner.root.nativeConnection;
+      Invocation previous;
+      do {
+        previous = c.retained;
+        invocation.retainedNext = previous;
+      } while (!RETAINED.compareAndSet(c, previous, invocation));
+      invocation.retained = true;
+    }
+  }
+
+  private static void cleanupFailure(NativeConnection c, Invocation invocation) {
+    c.cleanupFailed = true;
+    if (invocation != null) {
+      invocation.cleanupFailed = true;
+    }
+  }
+
+  private static Invocation current(NativeConnection c) {
+    Invocation invocation = c.current;
+    return invocation != null && !invocation.ended
+        && invocation.actual == Thread.currentThread() ? invocation : null;
+  }
+
+  private static final class WeakKey extends WeakReference<Object> {
+    private final int hash;
+
+    WeakKey(Object value, ReferenceQueue<Object> queue) {
+      super(value, queue);
+      hash = System.identityHashCode(value);
+    }
+
+    @Override public int hashCode() {
+      return hash;
+    }
+
+    @Override public boolean equals(Object other) {
+      if (this == other) {
+        return true;
+      }
+      Object value = get();
+      return value != null && other instanceof WeakKey && value == ((WeakKey) other).get();
+    }
+  }
+
+  static final class NativeConnection {
+    final PgConnection connection;
+    NativeConnection next;
+    RootRef roots;
+    Opening opening;
+    Invocation current;
+    volatile Invocation retained;
+    Construction construction;
+    Construction constructions;
+    Native children;
+    Transfer transfer;
+    final ReferenceQueue<Object> deadLives = new ReferenceQueue<>();
+    final HashMap<WeakKey, Life> otherLives = new HashMap<>();
+    volatile long nativeChildren;
+    volatile long failedConstructions;
+    volatile boolean cleanupFailed;
+    volatile boolean uncertain;
+    volatile boolean constructorEnded;
+    boolean constructorReturned;
+    boolean cleaned;
+    boolean terminalCleanup;
+    QueryExecutor executor;
+    PgConnectionCleaningAction action;
+    LazyCleaner.Cleanable<IOException> cleanable;
+
+    NativeConnection(PgConnection connection) {
+      this.connection = connection;
+    }
+
+    void drainWeakLives() {
+      WeakKey key;
+      while ((key = (WeakKey) deadLives.poll()) != null) {
+        otherLives.remove(key);
+      }
+    }
+  }
+
+  static NativeConnection connectionStarted(@UnknownInitialization PgConnection connection) {
+    prepareRuntime();
+    NativeConnection c = new NativeConnection(connection);
+    Opening opening = OPENING.get();
+    if (opening != null && !opening.ended && opening.thread == Thread.currentThread()) {
+      c.opening = opening;
+      c.next = opening.connections;
+      opening.connections = c;
+    }
+    return c;
+  }
+
+  static void connectionEnded(NativeConnection c, boolean returned) {
+    c.constructorReturned = returned;
+    c.constructorEnded = true;
+  }
+
+  static final class Construction {
+    final NativeConnection connection;
+    final Thread thread = Thread.currentThread();
+    final int kind;
+    final Invocation cause;
+    Construction parent;
+    Construction next;
+    Object receiver;
+    Native nativeState;
+    Borrow borrows;
+    ResultCursor cursor;
+    boolean receiverComplete;
+    boolean returned;
+    volatile boolean ended;
+    boolean cleaned;
+    boolean cleanupFailed;
+
+    Construction(NativeConnection connection, int kind, ResultCursor cursor) {
+      this.connection = connection;
+      this.kind = kind;
+      this.cursor = cursor;
+      this.cause = current(connection);
+    }
+  }
+
+  static Construction reserve(NativeConnection c, int kind, @Nullable ResultCursor cursor) {
+    Construction record = new Construction(c, kind, cursor);
+    long count = Math.addExact(c.nativeChildren, 1L);
+    record.parent = c.construction;
+    record.next = c.constructions;
+    c.constructions = record;
+    c.construction = record;
+    c.nativeChildren = count;
+    return record;
+  }
+
+  static void constructionReceiver(Construction record, Object receiver) {
+    record.receiver = receiver;
+    record.receiverComplete = true;
+  }
+
+  static void constructionEnded(Construction record, boolean returned) {
+    NativeConnection c = record.connection;
+    c.construction = record.parent;
+    record.parent = null;
+    record.returned = returned;
+    if (returned) {
+      if (record.nativeState != null) {
+        record.nativeState.available = true;
+      }
+      record.borrows = null;
+      record.cursor = null;
+    } else {
+      c.failedConstructions++;
+      c.nativeChildren--;
+      if (record.nativeState != null) {
+        record.nativeState.counted = false;
+      }
+    }
+    record.ended = true;
+  }
+
+  static final class Borrow {
+    CachedQuery query;
+    Borrow next;
+  }
+
+  static @Nullable Borrow reserveBorrow(NativeConnection c, int kind) {
+    Construction record = c.construction;
+    if (record == null || record.thread != Thread.currentThread() || record.ended
+        || record.kind != kind) {
+      return null;
+    }
+    Borrow borrow = new Borrow();
+    borrow.next = record.borrows;
+    record.borrows = borrow;
+    return borrow;
+  }
+
+  static final class Native {
+    final NativeConnection connection;
+    final Life life;
+    Object receiver;
+    Native next;
+    boolean available;
+    boolean counted = true;
+    boolean partialDisposed;
+    @Nullable Node queries;
+    @Nullable Node queryTail;
+    @Nullable Node parameters;
+    @Nullable Node parameterTail;
+    Object queryList;
+    Object parameterList;
+    HashMap<String, Row> rows = new HashMap<>();
+    Object rowMap;
+    @Nullable Batch activeBatch;
+
+    Native(NativeConnection connection, Object receiver, int kind, Life parent) {
+      this.connection = connection;
+      this.receiver = receiver;
+      this.life = new Life(connection, parent, kind, this);
+    }
+  }
+
+  static Native nativeStarted(NativeConnection c, @UnknownInitialization Object receiver, int kind) {
+    return nativeStarted(c, receiver, kind, null);
+  }
