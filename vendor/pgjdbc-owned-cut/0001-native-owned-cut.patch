+  private static boolean bindingLive(Binding binding, Invocation invocation) {
+    if (binding == null || binding.dependencies.length == 0) {
+      return true;
+    }
+    if (invocation == null || !sameOwner(binding.owner, invocation.owner)
+        || binding.owner.original != Thread.currentThread()) {
+      return false;
+    }
+    for (Life life : binding.dependencies) {
+      if (!liveFor(binding.owner, life)) {
+        return false;
+      }
+    }
+    return true;
+  }
