+  private static Pin pin(Native n, Object left, Object right) {
+    if (n == null) {
+      return null;
+    }
+    Invocation cause = current(n.connection);
+    if (cause == null) {
+      // Opening has no guarded values. For ordinary, unowned pgjdbc use, C/Q and
+      // the native stack remain the owners; do not retain an unbounded call history.
+      return null;
+    }
+    Pin pin = new Pin(cause, left, right);
+    pin.next = cause.pins;
+    cause.pins = pin;
+    return pin;
+  }
