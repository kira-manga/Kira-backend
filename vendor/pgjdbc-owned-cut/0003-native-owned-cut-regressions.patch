+package org.postgresql.jdbc;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.postgresql.PGProperty;
+import org.postgresql.core.ParameterList;
+import org.postgresql.test.TestUtil;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.lang.reflect.Field;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.sql.BatchUpdateException;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Native ABI tests, not a substitute for authentic backend producer/admission tests. */
+class KiraOwnedJdbcCutBatchTest {
+  static final Class<?>[] NONE = new Class<?>[0];
+  static final Object[] NO_ARGUMENTS = new Object[0];
+
+  @Test
+  void unarmedClosedChildrenDoNotBecomeConnectionHistory() throws Exception {
+    try (Connection raw = TestUtil.openDB()) {
+      PgConnection connection = (PgConnection) raw;
+      assertNull(connection.kira.opening);
+      for (int i = 0; i < 24; i++) {
+        byte[] payload = new byte[65536];
+        payload[0] = (byte) i;
+        PgPreparedStatement statement = (PgPreparedStatement) connection.prepareStatement("select ?::bytea");
+        PgResultSet result;
+        try (PreparedStatement closeStatement = statement) {
+          statement.setBytes(1, payload);
+          result = (PgResultSet) statement.executeQuery();
+          try (ResultSet closeResult = result) {
+            assertTrue(result.next());
+            assertArrayEquals(payload, result.getBytes(1));
+          }
+        }
+        assertEquals(2, KiraOwnedJdbcCut.firstCloseState(statement.kira.life));
+        assertEquals(2, KiraOwnedJdbcCut.firstCloseState(result.kira.life));
+        // This is the actual newly introduced reachability structure, not a GC timeout.
+        assertNull(connection.kira.construction);
+        assertNull(connection.kira.constructions);
+        assertNull(connection.kira.children);
+        assertEquals(0, connection.kira.nativeChildren);
+      }
+    }
+  }
+
+  @Test
+  void staleCurrentRefusesBeforeCopyAndScalarCurrentDoesNotValidateOldQueue() throws Exception {
+    try (Owned f = new Owned(false)) {
+      f.sql("create temporary table kira_cut_batch (payload bytea)");
+      PgPreparedStatement p = f.prepare("insert into kira_cut_batch values (?)");
+      ByteArrayInputStream first = new ByteArrayInputStream(new byte[]{1});
+      KiraOwnedJdbcCut.Life firstLife = f.life(first);
+      f.bindStream(p, first, firstLife, true);
+      KiraOwnedJdbcCut.revoke(f.owner, firstLife);
+      assertThrows(SQLException.class, () -> f.call(p, PreparedStatement.class, "addBatch", NONE));
+      assertNull(p.batchParameters, "Rejected C must not even create/copy a queued group.");
+
+      ByteArrayInputStream queued = new ByteArrayInputStream(new byte[]{2});
+      KiraOwnedJdbcCut.Life queuedLife = f.life(queued);
+      f.bindStream(p, queued, queuedLife, true);
+      f.call(p, PreparedStatement.class, "addBatch", NONE);
+      ParameterList copied = p.batchParameters.get(0);
+      KiraOwnedJdbcCut.Node queuedImage = p.kira.parameters;
+      f.call(p, PreparedStatement.class, "setBytes", new Class<?>[]{int.class, byte[].class}, 1, new byte[]{3});
+      KiraOwnedJdbcCut.revoke(f.owner, queuedLife);
+      assertEquals(1, f.call(p, PreparedStatement.class, "executeUpdate", NONE));
+      for (int i = 0; i < 2; i++) {
+        assertThrows(SQLException.class, () -> f.call(p, Statement.class, "executeBatch", NONE));
+        assertEquals(6, KiraOwnedJdbcCut.drainState(f.last));
+        assertSame(copied, p.batchParameters.get(0));
+        assertSame(queuedImage, p.kira.parameters);
+      }
+      f.call(p, Statement.class, "clearBatch", NONE);
+      assertTrue(p.batchParameters.isEmpty());
+      assertNull(p.kira.parameters);
+      assertEquals(0, ((int[]) f.call(p, Statement.class, "executeBatch", NONE)).length);
+      assertEquals(6, KiraOwnedJdbcCut.drainState(f.last));
+    }
+  }
+
+  @Test
+  void committedArraysStayOwnedAcrossNestedCallsAndNextQueueSurvivesActualEnd() throws Exception {
+    try (Owned f = new Owned(false)) {
+      f.sql("create temporary table kira_cut_batch (payload bytea)");
+      PgPreparedStatement p = f.prepare("insert into kira_cut_batch values (?)");
+      ByteArrayInputStream input = new ByteArrayInputStream(new byte[]{1});
+      KiraOwnedJdbcCut.Life life = f.life(input);
+      f.bindStream(p, input, life, true);
+      f.call(p, PreparedStatement.class, "addBatch", NONE);
+      ParameterList current = p.preparedParameters;
+      Method operation = Statement.class.getMethod("executeBatch");
+      KiraOwnedJdbcCut.Invocation outer = f.begin(p, operation, NO_ARGUMENTS);
+      KiraOwnedJdbcCut.Batch batch;
+      ParameterList next;
+      try {
+        assertArrayEquals(new int[]{1}, p.executeBatch());
+        assertEquals(5, KiraOwnedJdbcCut.drainState(outer));
+        batch = (KiraOwnedJdbcCut.Batch) field(outer, "batch");
+        assertNotNull(batch.parameters);
+        assertNotNull(batch.queries);
+        assertSame(current, p.preparedParameters);
+        KiraOwnedJdbcCut.revoke(f.owner, life);
+        assertThrows(SQLException.class, () -> f.call(p, PreparedStatement.class, "executeUpdate", NONE));
+        assertNotNull(batch.parameters, "Nested actualEnd must not release the admitted ancestor's A.");
+        f.call(p, PreparedStatement.class, "setBytes", new Class<?>[]{int.class, byte[].class}, 1, new byte[]{2});
+        f.call(p, PreparedStatement.class, "addBatch", NONE);
+        next = p.batchParameters.get(0);
+        assertNotNull(batch.parameters);
+      } finally {
+        f.end(outer);
+      }
+      assertEquals(5, KiraOwnedJdbcCut.drainState(outer));
+      assertNull(batch.parameters);
+      assertNull(batch.queries);
+      assertSame(next, p.batchParameters.get(0));
+      assertArrayEquals(new int[]{1}, (int[]) f.call(p, Statement.class, "executeBatch", NONE));
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void rewrittenAndLargeBatchesUseTheActualNativeShapes(boolean rewrite) throws Exception {
+    try (Owned f = new Owned(rewrite)) {
+      f.sql("create temporary table kira_cut_batch (id integer)");
+      PgPreparedStatement p = f.prepare("insert into kira_cut_batch values (?)");
+      for (int i = 1; i <= 3; i++) {
+        f.call(p, PreparedStatement.class, "setInt", new Class<?>[]{int.class, int.class}, 1, i);
+        f.call(p, PreparedStatement.class, "addBatch", NONE);
+      }
+      assertEquals(rewrite ? 1 : 3, p.batchStatements.size());
+      assertEquals(3, p.batchParameters.size());
+      assertEquals(3, ((long[]) f.call(p, Statement.class, "executeLargeBatch", NONE)).length);
+      assertEquals(5, KiraOwnedJdbcCut.drainState(f.last));
+      assertTrue(p.batchStatements.isEmpty());
+      assertTrue(p.batchParameters.isEmpty());
+      assertNull(p.kira.queries);
+      assertNull(p.kira.parameters);
+      assertEquals(3, f.scalar("select count(*) from kira_cut_batch"));
+    }
+  }
+
+  @Test
+  void eagerUnknownLengthContentAndSharedEmptyListsStayIndependent() throws Exception {
+    try (Owned f = new Owned(false)) {
+      f.sql("create temporary table kira_cut_batch (payload bytea)");
+      PgPreparedStatement p = f.prepare("insert into kira_cut_batch values (?)");
+      ByteArrayInputStream input = new ByteArrayInputStream(new byte[]{4, 5});
+      KiraOwnedJdbcCut.Life life = f.life(input);
+      f.bindStream(p, input, life, false);
+      assertEquals(0, input.available());
+      KiraOwnedJdbcCut.revoke(f.owner, life);
+      assertEquals(1, f.call(p, PreparedStatement.class, "executeUpdate", NONE));
+      PgPreparedStatement empty1 = f.prepare("select 1");
+      PgPreparedStatement empty2 = f.prepare("select 2");
+      assertSame(empty1.preparedParameters, empty2.preparedParameters);
+      assertNull(field(field(empty1.preparedParameters, "kira"), "owner"));
+      assertEquals(0, KiraOwnedJdbcCut.rootState(f.root));
+    }
+  }
+
+  @Test
+  void nativeSqlFailureAfterDrainDoesNotTurnCommittedBackIntoPre() throws Exception {
+    try (Owned f = new Owned(false)) {
+      f.sql("create temporary table kira_cut_batch (id integer primary key)");
+      PgPreparedStatement p = f.prepare("insert into kira_cut_batch values (?)");
+      f.call(p, PreparedStatement.class, "setInt", new Class<?>[]{int.class, int.class}, 1, 7);
+      f.call(p, PreparedStatement.class, "addBatch", NONE);
+      f.call(p, PreparedStatement.class, "addBatch", NONE);
+      ParameterList current = p.preparedParameters;
+      assertThrows(BatchUpdateException.class, () -> f.call(p, Statement.class, "executeBatch", NONE));
+      assertEquals(5, KiraOwnedJdbcCut.drainState(f.last));
+      assertTrue(p.batchStatements.isEmpty());
+      assertTrue(p.batchParameters.isEmpty());
+      assertSame(current, p.preparedParameters);
+      KiraOwnedJdbcCut.Batch batch = (KiraOwnedJdbcCut.Batch) field(f.last, "batch");
+      assertNull(batch.queries);
+      assertNull(batch.parameters);
+      assertEquals(0, KiraOwnedJdbcCut.rootState(f.root));
+    }
+  }
+
+  @Test
+  void foreignCancellationDoesNotBorrowOrCompactTheOrdinaryInvocation() throws Exception {
+    try (Owned f = new Owned(false)) {
+      PgPreparedStatement p = f.prepare("select 1");
+      KiraOwnedJdbcCut.Invocation outer = f.begin(p, Statement.class.getMethod("executeBatch"), NO_ARGUMENTS);
+      AtomicReference<Throwable> failure = new AtomicReference<>();
+      Thread cancel = new Thread(() -> {
+        try {
+          Method operation = Statement.class.getMethod("cancel");
+          KiraOwnedJdbcCut.Invocation invocation = KiraOwnedJdbcCut.prepareInvocation(f.owner, p,
+              new Object(), operation, NO_ARGUMENTS, NO_ARGUMENTS, new KiraOwnedJdbcCut.Life[0], new int[0]);
+          KiraOwnedJdbcCut.arm(invocation);
+          try {
+            p.cancel(); // Idle cancellation proves stack separation, not wire-cancel success.
+          } finally {
+            try {
+              KiraOwnedJdbcCut.disarm(invocation);
+            } finally {
+              KiraOwnedJdbcCut.actualEnd(invocation);
+            }
+          }
+        } catch (Throwable error) {
+          failure.set(error);
+        }
+      }, "kira-native-test-cancel");
+      try {
+        cancel.start();
+        cancel.join(5000);
+        assertFalse(cancel.isAlive());
+        assertNull(failure.get());
+        assertSame(outer, f.connection.kira.current);
+        assertEquals(0, p.executeBatch().length);
+      } finally {
+        if (cancel.isAlive()) {
+          cancel.interrupt();
+          cancel.join(5000);
+        }
+        f.end(outer);
+      }
+      assertEquals(6, KiraOwnedJdbcCut.drainState(outer));
+    }
+  }
+
+  static Object field(Object receiver, String name) throws Exception {
+    for (Class<?> type = receiver.getClass(); type != null; type = type.getSuperclass()) {
+      try {
+        Field field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        return field.get(receiver);
+      } catch (NoSuchFieldException ignored) {
+        // Read the original declaring class, never replace the native receiver.
+      }
+    }
+    throw new NoSuchFieldException(name);
+  }
+
+  static Properties properties(boolean rewrite) throws Exception {
+    TestUtil.initDriver();
+    Properties requested = new Properties();
+    PGProperty.LOGIN_TIMEOUT.set(requested, 0);
+    PGProperty.PREFER_QUERY_MODE.set(requested, "extended");
+    PGProperty.REWRITE_BATCHED_INSERTS.set(requested, rewrite);
+    return TestUtil.mergeDefaultProperties(requested);
+  }
+
+  /** This fixture issues native cells only. Backend tests separately authenticate real GuardCalls. */
+  static final class Owned implements AutoCloseable {
+    final KiraOwnedJdbcCut.Opening opening;
+    final PgConnection connection;
+    final KiraOwnedJdbcCut.Root root;
+    final KiraOwnedJdbcCut.Owner owner;
+    KiraOwnedJdbcCut.Invocation last;
+    boolean retired;
+
+    Owned(boolean rewrite) throws Exception {
+      Properties properties = properties(rewrite);
+      org.postgresql.Driver driver = new org.postgresql.Driver();
+      opening = KiraOwnedJdbcCut.prepareOpening(driver, new Object());
+      KiraOwnedJdbcCut.armOpening(opening);
+      PgConnection connected = null;
+      try {
+        try {
+          connected = (PgConnection) Objects.requireNonNull(driver.connect(TestUtil.getURL(properties), properties));
+          KiraOwnedJdbcCut.recordReturned(opening, connected);
+        } finally {
+          KiraOwnedJdbcCut.endOpening(opening);
+        }
+        connection = connected;
+        root = KiraOwnedJdbcCut.attach(opening, connection, new Object(), new Object());
+        owner = KiraOwnedJdbcCut.owner(root);
+      } catch (Exception | Error failure) {
+        try {
+          if (connected != null) {
+            connected.abort(Runnable::run);
+          }
+        } catch (Throwable cleanup) {
+          failure.addSuppressed(cleanup);
+        }
+        KiraOwnedJdbcCut.cleanupOpening(opening);
+        try {
+          if (connected != null) {
+            connected.close();
+          }
+        } catch (Throwable cleanup) {
+          failure.addSuppressed(cleanup);
+        }
+        throw failure;
+      }
+    }
+
+    KiraOwnedJdbcCut.Life life(Object identity) throws SQLException {
+      return KiraOwnedJdbcCut.life(owner, identity, null, true);
+    }
+
+    KiraOwnedJdbcCut.Invocation begin(Object receiver, Method operation, Object[] arguments) throws SQLException {
+      return begin(receiver, operation, arguments, NO_ARGUMENTS, new KiraOwnedJdbcCut.Life[0], new int[0]);
+    }
+
+    KiraOwnedJdbcCut.Invocation begin(Object receiver, Method operation, Object[] arguments,
+        Object[] known, KiraOwnedJdbcCut.Life[] lives, int[] positions) throws SQLException {
+      KiraOwnedJdbcCut.Invocation invocation = KiraOwnedJdbcCut.prepareInvocation(owner, receiver,
+          new Object(), operation, arguments, known, lives, positions);
+      KiraOwnedJdbcCut.arm(invocation);
+      last = invocation;
+      return invocation;
+    }
+
+    void end(KiraOwnedJdbcCut.Invocation invocation) throws SQLException {
+      try {
+        KiraOwnedJdbcCut.disarm(invocation);
+      } finally {
+        KiraOwnedJdbcCut.actualEnd(invocation);
+        last = invocation;
+      }
+    }
+
+    Object call(Object receiver, Class<?> api, String name, Class<?>[] types, Object... arguments) throws Exception {
+      return knownCall(receiver, api.getMethod(name, types), arguments, NO_ARGUMENTS,
+          new KiraOwnedJdbcCut.Life[0], new int[0]);
+    }
+
+    Object knownCall(Object receiver, Method operation, Object[] arguments, Object[] known,
+        KiraOwnedJdbcCut.Life[] lives, int[] positions) throws Exception {
+      KiraOwnedJdbcCut.Invocation invocation = begin(receiver, operation, arguments, known, lives, positions);
+      try {
+        return operation.invoke(receiver, arguments);
+      } catch (InvocationTargetException failure) {
+        Throwable cause = failure.getCause();
+        if (cause instanceof Exception) {
+          throw (Exception) cause;
+        }
+        throw (Error) cause;
+      } finally {
+        end(invocation);
+      }
+    }
+
+    void bindStream(PgPreparedStatement statement, InputStream input, KiraOwnedJdbcCut.Life life,
+        boolean lengthKnown) throws Exception {
+      Method method = lengthKnown
+          ? PreparedStatement.class.getMethod("setBinaryStream", int.class, InputStream.class, int.class)
+          : PreparedStatement.class.getMethod("setBinaryStream", int.class, InputStream.class);
+      Object[] args = lengthKnown ? new Object[]{1, input, 1} : new Object[]{1, input};
+      knownCall(statement, method, args, new Object[]{input}, new KiraOwnedJdbcCut.Life[]{life}, new int[]{1});
+    }
+
+    PgPreparedStatement prepare(String sql) throws Exception {
+      return (PgPreparedStatement) call(connection, Connection.class, "prepareStatement", new Class<?>[]{String.class}, sql);
+    }
+
+    PgStatement statement() throws Exception {
+      return (PgStatement) call(connection, Connection.class, "createStatement", NONE);
+    }
+
+    void sql(String sql) throws Exception {
+      PgStatement statement = statement();
+      try {
+        call(statement, Statement.class, "executeUpdate", new Class<?>[]{String.class}, sql);
+      } finally {
+        call(statement, Statement.class, "close", NONE);
+      }
+    }
+
+    int scalar(String sql) throws Exception {
+      PgStatement statement = statement();
+      try {
+        ResultSet result = (ResultSet) call(statement, Statement.class, "executeQuery", new Class<?>[]{String.class}, sql);
+        call(result, ResultSet.class, "next", NONE);
+        return (Integer) call(result, ResultSet.class, "getInt", new Class<?>[]{int.class}, 1);
+      } finally {
+        call(statement, Statement.class, "close", NONE);
+      }
+    }
+
+    void retire() throws SQLException {
+      if (!retired) {
+        retired = true;
+        try {
+          connection.abort(Runnable::run);
+        } finally {
+          try {
+            KiraOwnedJdbcCut.cleanupOpening(opening);
+          } finally {
+            connection.close();
+          }
+        }
+      }
+    }
+
+    @Override
+    public void close() throws SQLException {
+      retire();
+    }
+  }
+}
