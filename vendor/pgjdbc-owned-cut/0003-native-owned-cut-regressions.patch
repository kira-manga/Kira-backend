+package org.postgresql.core.v3;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.postgresql.core.Oid;
+import org.postgresql.jdbc.KiraOwnedJdbcCut;
+import org.postgresql.util.StreamWrapper;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.lang.reflect.Field;
+import java.sql.SQLException;
+import java.sql.Types;
+
+/** Actual concrete-list stores; known-Life/SQL execution is covered by the JDBC tests. */
+class KiraOwnedParameterBridgeTest {
+  private static final TypeTransferModeRegistry TEXT = new TypeTransferModeRegistry() {
+    @Override
+    public boolean useBinaryForSend(int oid) {
+      return false;
+    }
+
+    @Override
+    public boolean useBinaryForReceive(int oid) {
+      return false;
+    }
+  };
+
+  @BeforeEach
+  void initializeClosedBridge() {
+    KiraOwnedJdbcCut.prepareRuntime();
+  }
+
+  @Test
+  void nullAndPureOutPublishTheActualStoredRepresentation() throws Exception {
+    SimpleParameterList list = new SimpleParameterList(1, TEXT);
+    list.setBytea(1, new ByteArrayInputStream(new byte[]{1}), 1);
+    KiraOwnedJdbcCut.Binding retained = list.kira.bindings[0];
+    list.setNull(1, Oid.UNSPECIFIED); // The native early return must not miss this store.
+    assertNotSame(retained, list.kira.bindings[0]);
+    assertSame(list.getValues()[0], stored(list.kira.bindings[0]));
+    assertEquals(Oid.BYTEA, list.getParamTypes()[0]);
+
+    SimpleParameterList out = new SimpleParameterList(1, TEXT);
+    out.registerOutParameter(1, Types.BINARY);
+    out.convertFunctionOutParameters();
+    assertEquals(Oid.VOID, out.getParamTypes()[0]);
+    assertNotNull(out.getValues()[0]);
+    assertSame(out.getValues()[0], stored(out.kira.bindings[0]));
+    assertEquals(0, out.kira.changing);
+    assertFalse(out.kira.unknown);
+  }
+
+  @Test
+  void explicitLengthKeepsTheSourceAndUnknownLengthReallyCopiesIt() throws Exception {
+    SimpleParameterList list = new SimpleParameterList(2, TEXT);
+    ByteArrayInputStream deferred = new ByteArrayInputStream(new byte[]{1, 2});
+    ByteArrayInputStream eager = new ByteArrayInputStream(new byte[]{3, 4});
+    list.setBytea(1, deferred, 2);
+    list.setBytea(2, eager);
+    StreamWrapper retaining = (StreamWrapper) list.getValues()[0];
+    StreamWrapper copied = (StreamWrapper) list.getValues()[1];
+    assertSame(deferred, retaining.getStream());
+    assertNull(retaining.getBytes());
+    assertEquals(2, deferred.available());
+    assertEquals(0, eager.available());
+    assertArrayEquals(new byte[]{3, 4}, copied.getBytes());
+    assertNotSame(eager, copied.getStream());
+    assertSame(retaining, stored(list.kira.bindings[0]));
+    assertSame(copied, stored(list.kira.bindings[1]));
+  }
+
+  @Test
+  void copyClearAndAppendTrackOnlyTheRealCopiedRange() throws Exception {
+    SimpleParameterList source = new SimpleParameterList(2, TEXT);
+    source.setIntParameter(1, 7);
+    source.setIntParameter(2, 8);
+    SimpleParameterList copy = (SimpleParameterList) source.copy();
+    assertNotSame(source.getValues(), copy.getValues());
+    assertSame(source.kira.bindings[0], copy.kira.bindings[0]);
+    Object saved = copy.getValues()[0];
+    source.clear();
+    assertNull(source.getValues()[0]);
+    assertNull(source.kira.bindings[0]);
+    assertSame(saved, copy.getValues()[0]);
+
+    SimpleParameterList destination = new SimpleParameterList(3, TEXT);
+    destination.setIntParameter(1, 6);
+    KiraOwnedJdbcCut.Binding first = destination.kira.bindings[0];
+    destination.appendAll(copy);
+    assertSame(first, destination.kira.bindings[0]);
+    assertSame(copy.getValues()[0], destination.getValues()[1]);
+    assertSame(copy.kira.bindings[0], destination.kira.bindings[1]);
+    assertSame(copy.kira.bindings[1], destination.kira.bindings[2]);
+    assertThrows(SQLException.class, () -> destination.appendAll(copy));
+    assertSame(copy.kira.bindings[1], destination.kira.bindings[2]);
+    assertEquals(0, destination.kira.changing);
+  }
+
+  @Test
+  void compositeTranslationCopyAndNoOpAppendKeepNativeSemantics() throws Exception {
+    SimpleParameterList left = new SimpleParameterList(1, TEXT);
+    SimpleParameterList right = new SimpleParameterList(2, TEXT);
+    CompositeParameterList composite = new CompositeParameterList(
+        new SimpleParameterList[]{left, right}, new int[]{0, 1});
+    composite.setIntParameter(2, 11);
+    assertNull(left.kira.bindings[0]);
+    assertSame(right.getValues()[0], stored(right.kira.bindings[0]));
+    CompositeParameterList copy = (CompositeParameterList) composite.copy();
+    KiraOwnedJdbcCut.Binding saved = right.kira.bindings[0];
+    composite.appendAll(copy); // Stock CompositeParameterList deliberately does nothing.
+    assertSame(saved, right.kira.bindings[0]);
+    composite.clear();
+    assertNull(right.kira.bindings[0]);
+    assertSame(saved, copy.kira.children[1].kira.bindings[0]);
+    assertSame(copy.kira.children[1].getValues()[0], stored(saved));
+  }
+
+  @Test
+  void sharedEmptyContentNeverAcquiresAnOwnerOrChangingHistory() {
+    SimpleParameterList empty = SimpleQuery.NO_PARAMETERS;
+    for (int i = 0; i < 20; i++) {
+      empty.clear();
+      SimpleParameterList copy = (SimpleParameterList) empty.copy();
+      assertNull(copy.kira.owner);
+      assertEquals(0, copy.kira.bindings.length);
+    }
+    assertNull(empty.kira.owner);
+    assertEquals(0, empty.kira.changing);
+    assertFalse(empty.kira.unknown);
+    assertEquals(0, empty.kira.bindings.length);
+  }
+
+  private static Object stored(KiraOwnedJdbcCut.Binding binding) throws Exception {
+    Field field = KiraOwnedJdbcCut.Binding.class.getDeclaredField("stored");
+    field.setAccessible(true);
+    return field.get(binding); // Test-only read of the actual native publication, not a raw API.
+  }
+}
