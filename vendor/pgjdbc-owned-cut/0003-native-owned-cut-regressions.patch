+  private static PgPreparedStatement hiddenPrepared(PgConnection connection, CachedQuery query) {
+    for (KiraOwnedJdbcCut.Native child = connection.kira.children; child != null; child = child.next) {
+      if (child.receiver instanceof PgPreparedStatement) {
+        PgPreparedStatement statement = (PgPreparedStatement) child.receiver;
+        if (query == null ? KiraOwnedJdbcCut.firstCloseState(child.life) == 0 : statement.preparedQuery == query) {
+          return statement;
