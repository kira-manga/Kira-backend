+  /** Small local duplicate because the Mockito module cannot depend on another module's tests. */
+  private static final class Owned implements AutoCloseable {
+    final KiraOwnedJdbcCut.Opening opening;
+    final PgConnection connection;
+    final KiraOwnedJdbcCut.Root root;
+    final KiraOwnedJdbcCut.Owner owner;
+    KiraOwnedJdbcCut.Invocation last;
+    boolean retired;
+
+    Owned() throws Exception {
+      Properties properties = properties();
+      org.postgresql.Driver driver = new org.postgresql.Driver();
+      opening = KiraOwnedJdbcCut.prepareOpening(driver, new Object());
+      KiraOwnedJdbcCut.armOpening(opening);
+      PgConnection connected = null;
+      try {
+        try {
+          connected = (PgConnection) Objects.requireNonNull(driver.connect(TestUtil.getURL(properties), properties));
+          KiraOwnedJdbcCut.recordReturned(opening, connected);
+        } finally {
+          KiraOwnedJdbcCut.endOpening(opening);
+        }
+        connection = connected;
+        root = KiraOwnedJdbcCut.attach(opening, connection, new Object(), new Object());
+        owner = KiraOwnedJdbcCut.owner(root);
+      } catch (Exception | Error failure) {
+        try {
+          if (connected != null) {
+            connected.abort(Runnable::run);
+          }
+        } catch (Throwable cleanup) {
+          failure.addSuppressed(cleanup);
+        }
+        KiraOwnedJdbcCut.cleanupOpening(opening);
+        try {
+          if (connected != null) {
+            connected.close();
+          }
+        } catch (Throwable cleanup) {
+          failure.addSuppressed(cleanup);
+        }
+        throw failure;
+      }
+    }
+
+    Object call(Object receiver, Class<?> api, String name, Class<?>[] types, Object... arguments) throws Exception {
+      Method operation = api.getMethod(name, types);
+      KiraOwnedJdbcCut.Invocation invocation = KiraOwnedJdbcCut.prepareInvocation(owner, receiver, new Object(),
+          operation, arguments, NO_ARGUMENTS, new KiraOwnedJdbcCut.Life[0], new int[0]);
+      KiraOwnedJdbcCut.arm(invocation);
+      last = invocation;
+      try {
+        return operation.invoke(receiver, arguments);
+      } catch (InvocationTargetException failure) {
+        Throwable cause = failure.getCause();
+        if (cause instanceof Exception) {
+          throw (Exception) cause;
+        }
+        throw (Error) cause;
+      } finally {
+        try {
+          KiraOwnedJdbcCut.disarm(invocation);
+        } finally {
+          KiraOwnedJdbcCut.actualEnd(invocation);
+        }
+      }
+    }
+
+    PgPreparedStatement prepare(String sql) throws Exception {
+      return (PgPreparedStatement) call(connection, Connection.class, "prepareStatement", new Class<?>[]{String.class}, sql);
+    }
+
+    PgStatement statement() throws Exception {
+      return (PgStatement) call(connection, Connection.class, "createStatement", NONE);
+    }
+
+    void sql(String sql) throws Exception {
