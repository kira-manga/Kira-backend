+  /** Replace only a lower dependency for one lexical test scope, restoring exact identity. */
+  private static final class ExecutorFault implements AutoCloseable {
+    private final PgConnection connection;
+    private final QueryExecutor original;
+    private final Field slot;
+
+    ExecutorFault(PgConnection connection, Answer<Object> answer) throws Exception {
+      this.connection = connection;
+      original = connection.getQueryExecutor();
+      slot = PgConnection.class.getDeclaredField("queryExecutor");
+      slot.setAccessible(true);
+      slot.set(connection, mock(QueryExecutor.class, answer));
+    }
+
+    @Override
+    public void close() throws Exception {
+      slot.set(connection, original);
+    }
+  }
+
+  private static Object field(Object receiver, String name) throws Exception {
+    for (Class<?> type = receiver.getClass(); type != null; type = type.getSuperclass()) {
+      try {
+        Field field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        return field.get(receiver);
+      } catch (NoSuchFieldException ignored) {
+        // Read the authentic declaring class, not a replacement receiver.
+      }
+    }
+    throw new NoSuchFieldException(name);
+  }
